# ---------- Адрес бота ----------
# Поддомен, который указывает на ваш сервер (запись A в DNS)
DOMAIN=reels.example.kz
PUBLIC_BASE_URL=https://reels.example.kz

# ---------- Meta / Instagram ----------
# Любая длинная случайная строка. Её же вводите в кабинете Meta при настройке вебхука
META_VERIFY_TOKEN=
# Секрет приложения (App settings > Basic > App secret).
# Если подпись не совпадает, впишите через запятую оба секрета: приложения и Instagram
META_APP_SECRET=
# Токен доступа аккаунта Instagram. Нужен, чтобы узнать имя и ник клиента
IG_ACCESS_TOKEN=
IG_API_VERSION=v27.0
# Откуда боту разрешено скачивать ролики. Менять нужно только для шага 3 из README
MEDIA_ALLOWED_HOSTS=fbsbx.com,fbcdn.net,cdninstagram.com,instagram.com,facebook.com
# На время первой проверки поставьте 1: в журнал попадёт полный текст событий от Meta
LOG_RAW_EVENTS=0

# ---------- Claude ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 0 отключает бриф: бот будет только сохранять ролик и давать ссылку
BRIEF_ENABLED=1
# Запасная модель на случай отказа основной. Для моделей Haiku поставьте 0
CLAUDE_FALLBACKS=1
BRIEF_LANGUAGE=русский
# Необязательно: текстовый файл с названиями и артикулами, например /data/catalog.txt
CATALOG_PATH=

# ---------- Битрикс24 ----------
# Входящий вебхук с правами crm, im и imbot, вида https://ВАШ.bitrix24.kz/rest/1/xxxxxxxx
BITRIX_WEBHOOK_URL=
# Чат менеджеров. Обычно не нужен: команда python -m app.bitrix_setup connect chat123
# сама запоминает чат. Заполните, только если работаете без бота
BITRIX_DIALOG_ID=
# Имя бота в Битрикс24. Меняйте до первого подключения
BITRIX_BOT_NAME=Рилс бот
# 1 = в чат всегда приходит полный бриф, 0 = только ссылка на карточку, если она нашлась
BITRIX_CHAT_FULL=1
# Ролики до этого размера прикладываются файлом в карточку, остальные только ссылкой
BITRIX_ATTACH_VIDEO_MAX_MB=15

# ---------- Хранение ----------
MEDIA_RETENTION_DAYS=30
